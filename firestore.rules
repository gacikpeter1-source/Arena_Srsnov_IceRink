rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Role hierarchy (see src/types/index.ts StaffRole for the full
    // explanation): superadmin > owner ("Club owner") > assistant, plus
    // 'pending' for a self-registered account awaiting a role grant.
    // Each deployment serves exactly one club (see CLAUDE.md's
    // multi-tenant model — new customer = new deployment), so none of
    // this needs to be scoped by clubId beyond what's already implicit.

    function isSignedIn() {
      return request.auth != null;
    }

    function hasStaffDoc() {
      return isSignedIn() && exists(/databases/$(database)/documents/staff/$(request.auth.uid));
    }

    function myRole() {
      return hasStaffDoc()
        ? get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.role
        : null;
    }

    function isSuperAdmin() {
      return myRole() == 'superadmin';
    }

    function isOwner() {
      return myRole() == 'owner';
    }

    // Can manage bookings/schedules — day-to-day operations.
    function isStaffMember() {
      return myRole() in ['superadmin', 'owner', 'assistant'];
    }

    // Manages only their own training sessions/series/bundles — independent
    // of `role` (an account can be isStaffMember() AND isTrainer() at once).
    // A trainer flag alone grants no access to ice-rink bookings or
    // club-wide config.
    function isTrainer() {
      return hasStaffDoc()
        && get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.isTrainer == true;
    }

    // Can manage club config, grant/revoke the 'assistant' role, and
    // grant/revoke the isTrainer flag on anyone but an owner/superadmin.
    function isOwnerOrAbove() {
      return myRole() in ['superadmin', 'owner'];
    }

    // Club config — public read (needed to render the booking UI with no
    // login), writes restricted to the club's owner/superadmin.
    match /clubs/{clubId} {
      allow read: if true;
      allow create: if isOwnerOrAbove();
      // The `entitlements` map (paid add-on modules — see
      // lib/entitlements.ts) is superadmin-only: that's the app operator
      // deciding what a club is subscribed to, not something the club's
      // own owner/assistant can grant themselves. Every other club field
      // stays owner-or-above, same as before.
      allow update: if isSuperAdmin()
        || (isOwnerOrAbove() && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['entitlements']));
      allow delete: if isSuperAdmin();
    }

    // A club's physical ice surfaces (e.g. "Main Hall", "Small Hall").
    // Public read (needed to render the booking calendar with no login).
    match /rinks/{rinkId} {
      allow read: if true;
      allow create, update: if isStaffMember();
      allow delete: if isOwnerOrAbove();
    }

    match /zones/{zoneId} {
      allow read: if true;
      allow create, update: if isStaffMember();
      allow delete: if isOwnerOrAbove();
    }

    match /timeSlotConfig/{configId} {
      allow read: if true;
      allow write: if isStaffMember();
    }

    // Recurring windows where the rink is offered as halves/thirds instead
    // of the default whole-rink booking (see src/lib/divisionRules.ts).
    match /divisionRules/{ruleId} {
      allow read: if true;
      allow create, update: if isStaffMember();
      allow delete: if isStaffMember();
    }

    // One-off, per-rink+date hand-adjusted schedules that override the
    // recurring timeSlotConfig default for that day only (see
    // src/lib/scheduleOverrides.ts). Public read — same reason as
    // timeSlotConfig, the booking calendar needs it with no login.
    match /scheduleOverrides/{overrideId} {
      allow read: if true;
      allow write: if isStaffMember();
    }

    match /staff/{uid} {
      // Anyone signed in may read their own doc (to see their own role).
      allow read: if isSignedIn() && request.auth.uid == uid;
      // Any active staff member can see the roster.
      allow read: if isStaffMember();
      // Public trainer directory (/treningy/treneri) — no login, so this
      // has to be a plain public rule rather than isTrainer(), which
      // depends on the CALLER's own staff doc. Firestore evaluates `read`
      // per-document for list queries when the rule only depends on
      // resource.data, so a `where('isTrainer','==',true)` query safely
      // returns only trainer docs — everyone else's stays private.
      allow read: if resource.data.isTrainer == true;

      // Self-registration: create your OWN doc, but only as 'pending' —
      // you cannot grant yourself a real role.
      allow create: if isSignedIn() && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.role == 'pending';

      // Role/trainer changes: superadmin can change anything on anyone; an
      // owner can only touch rows that are currently 'pending' or
      // 'assistant' (never an owner/superadmin row), and only the role,
      // isTrainer and pendingRole fields — this is also how a trainer's
      // invite-code signup (role stays 'pending' with pendingRole:'trainer'
      // until approved — see StaffUser in src/types/index.ts) gets approved
      // by setting isTrainer:true and clearing pendingRole.
      allow update: if isSuperAdmin()
        || (isOwner()
            && resource.data.role in ['pending', 'assistant']
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role', 'isTrainer', 'pendingRole'])
            && request.resource.data.role in ['pending', 'assistant']);

      allow delete: if isSuperAdmin();
    }

    // Bookings: publicly creatable (anonymous booking, no login required)
    // and publicly readable so a customer can look themselves up by
    // confirmation code + email, or via their emailed cancel-link token.
    //
    // KNOWN LIMITATION (same trade-off the Arena-Srsnov reference app
    // makes on its `registrations` collection): public read also allows
    // listing/querying the whole collection directly, not just doc-by-id
    // lookups. Fine for a first build; before real traffic, move lookup
    // and cancellation through a Cloud Function so the client never
    // queries `bookings` directly.
    match /bookings/{bookingId} {
      allow read: if true;
      allow create: if true;
      // Public (customer self-cancel): only allow flipping status to
      // 'cancelled' (+ timestamp) — never arbitrary edits to name/zone/time.
      // Also locked out within CANCELLATION_CUTOFF_HOURS (lib/bookings.ts)
      // of the booking's start — the UI already hides the cancel button by
      // then, this is the server-side backstop against a direct API call.
      // Bookings written before startAtUtc existed have no cutoff to check,
      // so they fall back to the old (always-allowed) behavior.
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'cancelledAt'])
        && resource.data.status == 'confirmed'
        && request.resource.data.status == 'cancelled'
        && (!('startAtUtc' in resource.data)
            || request.time + duration.value(24, 'h') < resource.data.startAtUtc);
      // Public (email confirm link): 'pending' -> 'confirmed', or -> 'expired'
      // when confirmBooking (lib/bookings.ts) discovers the 5-minute window
      // already lapsed. Doesn't check the token itself — the client already
      // filters by cancellationToken before it gets here, and rules can't
      // see the URL param it came from anyway — same trust boundary as the
      // rest of this public-write collection (see KNOWN LIMITATION above).
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && resource.data.status == 'pending'
        && request.resource.data.status in ['confirmed', 'expired'];
      // Staff (admin dashboard): full edit rights — cancel, create,
      // correct contact details, etc.
      allow update: if isStaffMember();
    }

    // A weekly-recurring series' metadata (see src/types/index.ts
    // BookingSeries) — the occurrences themselves are normal `bookings`
    // docs tagged with seriesId, covered by the rules above. Same
    // public-write trade-off as bookings/slotLocks: anyone can create one
    // (no-login booking), and it's publicly readable so the emailed
    // "manage series" link works without an account.
    match /bookingSeries/{seriesId} {
      allow read: if true;
      allow create: if true;
    }

    // Slot locks back the atomic check-and-reserve transaction in
    // src/lib/bookings.ts. Same public-write trade-off as bookings above.
    match /slotLocks/{lockId} {
      allow read: if true;
      allow create: if true;
      allow delete: if true;
      // Two legitimate public-write shapes for an existing lock:
      // 1. confirmBooking finalizing a pending hold — only the `expiresAt`
      //    field is removed, nothing else about the lock changes.
      // 2. createBooking reclaiming a slot whose previous hold already
      //    expired (see PENDING_CONFIRMATION_MINUTES) — a full overwrite
      //    (new bookingId/expiresAt/etc.), but ONLY when the lock being
      //    replaced was itself already past its own expiresAt, so a still-
      //    valid hold can never be stolen or have its expiry tampered with.
      allow update: if
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['expiresAt']) && !('expiresAt' in request.resource.data))
        || ('expiresAt' in resource.data && resource.data.expiresAt < request.time);
    }

    // ---------------------------------------------------------------
    // Training reservations (korčuľovanie) — see src/types/index.ts for
    // the full data model rationale. Same public-write trade-offs as the
    // ice-rink collections above (documented once there, not repeated
    // per collection here).
    // ---------------------------------------------------------------

    // Gates trainer self-registration — see AuthContext.signupTrainer.
    // Public read so the signup form can show a friendly "invalid or
    // already-used code" error before even creating the Firebase Auth
    // account. Consumption (used:false -> true) is restricted to the
    // exact account it was issued for, and Firestore serializes writes to
    // a single document, so two people racing the same code can't both
    // win even without an explicit client-side transaction.
    match /trainerInviteCodes/{code} {
      allow read: if true;
      allow create: if isOwnerOrAbove();
      allow update: if isSignedIn()
        && resource.data.used == false
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['used', 'usedBy', 'usedAt'])
        && request.resource.data.used == true
        && request.resource.data.usedBy == request.auth.uid;
      allow delete: if isOwnerOrAbove();
    }

    // Metadata for a trainer's recurring session series (see
    // TrainingSeries) — each occurrence is its own trainingSessions doc.
    match /trainingSeries/{seriesId} {
      allow read: if true;
      allow create: if isTrainer() && request.resource.data.trainerId == request.auth.uid;
      allow update, delete: if isTrainer() && resource.data.trainerId == request.auth.uid;
      allow update, delete: if isOwnerOrAbove();
    }

    // A kurz/kemp bundle (see TrainingBundle) — one registration covers
    // every session it contains.
    match /trainingBundles/{bundleId} {
      allow read: if true;
      allow create: if isTrainer() && request.resource.data.trainerId == request.auth.uid;
      // Owning trainer manages their own bundle's own fields.
      allow update: if isTrainer() && resource.data.trainerId == request.auth.uid;
      // Public registration flow atomically adjusts confirmedCount only.
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['confirmedCount']);
      allow update, delete: if isOwnerOrAbove();
      allow delete: if isTrainer() && resource.data.trainerId == request.auth.uid;
    }

    // One real training hour (see TrainingSession) — publicly readable so
    // the calendar works with no login.
    match /trainingSessions/{sessionId} {
      allow read: if true;
      // A trainer creates their own session; an owner/superadmin creates
      // one via Excel import, with or without a trainer assigned.
      allow create: if (isTrainer() && request.resource.data.trainerId == request.auth.uid) || isOwnerOrAbove();
      // Owning trainer manages their own session's own fields.
      allow update: if isTrainer() && resource.data.trainerId == request.auth.uid;
      // Any approved trainer may claim an unassigned session — atomically,
      // guarded by the prior state having no trainerId at all.
      allow update: if isTrainer()
        && !('trainerId' in resource.data)
        && request.resource.data.trainerId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['trainerId', 'trainerName', 'status']);
      // Public registration flow atomically adjusts confirmedCount only.
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['confirmedCount']);
      // Ice-attendance checklist: any ice-rink staff member (not just the
      // owning trainer) confirms the trainer was physically present —
      // see setSessionTrainerPresence in lib/training.ts.
      allow update: if isStaffMember()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['trainerPresentConfirmed']);
      allow update, delete: if isOwnerOrAbove();
      allow delete: if isTrainer() && resource.data.trainerId == request.auth.uid;
    }

    // A customer's (no-login) registration for one TrainingSession — same
    // public-write/status-transition shape as `bookings` above: anonymous
    // create, pending -> confirmed/expired (email-confirm), confirmed ->
    // cancelled (self-cancel, respecting the session's own
    // cancellationCutoffHours), plus the owning trainer marking attendance.
    match /trainingRegistrations/{regId} {
      allow read: if true;
      allow create: if true;
      // Public self-cancel: from 'confirmed' (releases a reserved spot,
      // respecting the session's cancellationCutoffHours), or from
      // 'pending'/'waitlist' (a customer changing their mind before ever
      // being confirmed — no cutoff, since a pending hold only lasts
      // TRAINING_PENDING_CONFIRMATION_MINUTES anyway and a waitlist entry
      // never reserved real capacity in the first place).
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'cancelledAt'])
        && resource.data.status in ['confirmed', 'pending', 'waitlist']
        && request.resource.data.status == 'cancelled'
        && (resource.data.status != 'confirmed'
            || !('startAtUtc' in resource.data)
            || request.time + duration.value(get(/databases/$(database)/documents/trainingSessions/$(resource.data.sessionId)).data.cancellationCutoffHours, 'h') < resource.data.startAtUtc);
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && resource.data.status == 'pending'
        && request.resource.data.status in ['confirmed', 'expired'];
      // Automatic waitlist promotion (a system action triggered by an
      // unrelated cancellation freeing a spot — see
      // promoteNextWaitlistedSessionRegistration in lib/training.ts) — the
      // customer performing that cancel doesn't own this doc and needs no
      // special permission to trigger it, same public trust boundary as
      // the confirmedCount adjustment above.
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && resource.data.status == 'waitlist'
        && request.resource.data.status == 'confirmed';
      // Trainer marking attendance on their own session's registrations.
      allow update: if isTrainer()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['attendance'])
        && get(/databases/$(database)/documents/trainingSessions/$(resource.data.sessionId)).data.trainerId == request.auth.uid;
      allow update: if isOwnerOrAbove();
    }

    // A customer's (no-login) registration for an entire TrainingBundle —
    // same shape as trainingRegistrations above, scoped to the bundle.
    match /trainingBundleRegistrations/{regId} {
      allow read: if true;
      allow create: if true;
      // Public self-cancel from any of confirmed/pending/waitlist — no
      // cutoff on a bundle registration (see cancelBundleRegistration in
      // src/lib/training.ts for why that's deliberate).
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'cancelledAt'])
        && resource.data.status in ['confirmed', 'pending', 'waitlist']
        && request.resource.data.status == 'cancelled';
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && resource.data.status == 'pending'
        && request.resource.data.status in ['confirmed', 'expired'];
      // See the matching waitlist-promotion rule on trainingRegistrations above.
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && resource.data.status == 'waitlist'
        && request.resource.data.status == 'confirmed';
      allow update: if isTrainer()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['attendanceBySession'])
        && get(/databases/$(database)/documents/trainingBundles/$(resource.data.bundleId)).data.trainerId == request.auth.uid;
      allow update: if isOwnerOrAbove();
    }

    // A participant who showed up without registering — informal log,
    // deliberately kept available for people who don't use the app.
    match /trainingWalkIns/{walkInId} {
      allow read: if isTrainer() || isStaffMember();
      allow create: if isTrainer() || isStaffMember();
      allow delete: if isTrainer() || isStaffMember();
    }

    // A trainer using club ice with no booked session — club-oversight
    // tool. Deliberately NOT readable by trainers themselves, only by
    // owner/superadmin; assistants can log entries but not read the log
    // back (matches "asistent má samostatný dokument a toto nemusí byť
    // viditeľné pre trénera, ale musí to vidieť owner").
    match /trainerIceLog/{logId} {
      allow read: if isOwnerOrAbove();
      allow create: if isStaffMember();
      allow update, delete: if isOwnerOrAbove();
    }

    // Audit log of generated exports — owner/superadmin only, end to end.
    match /trainingReportHistory/{reportId} {
      allow read, write: if isOwnerOrAbove();
    }

    // A quickly-planned tournament (see CLAUDE.md's "Tournaments" section).
    // Read is public — the /turnaje schedule page (no login) lists
    // tournaments and their matches for customers/parents — but every
    // write stays trainer/assistant/owner/superadmin only. Any of them can
    // create; managing (update/delete) someone else's tournament is
    // restricted to ice-rink staff, same pattern as trainingSessions above
    // (a plain trainer only manages their own).
    match /tournaments/{tournamentId} {
      allow read: if true;
      allow create: if isTrainer() || isStaffMember();
      allow update, delete: if (isTrainer() && resource.data.createdBy == request.auth.uid) || isStaffMember();
    }

    // One scheduled match within a tournament — see TournamentMatch. Read
    // is public for the same /turnaje schedule page reason as tournaments
    // above; the page derives team names/standings straight from these
    // match docs' own denormalized fields, so tournamentTeams below stays
    // staff-only — nothing on the public page ever reads it.
    // Blocking real ice (blocksIce) writes a normal `bookings` doc via
    // the existing public-write path, so no extra rule is needed there.
    match /tournamentMatches/{matchId} {
      allow read: if true;
      allow create: if isTrainer() || isStaffMember();
      // Update is open to any trainer/staff (not just the bracket's
      // creator) — recording a live match result and having it
      // auto-advance the winner (see setTournamentMatchResult in
      // lib/tournaments.ts) is inherently a "whoever's at the rink"
      // action, same collaborative reasoning as tournamentTeams below.
      // Delete stays creator-restricted so one trainer can't casually
      // wipe another's carefully-built bracket.
      allow update: if isTrainer() || isStaffMember();
      allow delete: if (isTrainer() && resource.data.createdBy == request.auth.uid) || isStaffMember();
    }

    // A team entered into a tournament (see TournamentTeam) — any
    // trainer/staff who can see the tournament can manage its roster,
    // no per-team creator restriction (the whole club staff typically
    // collaborates on one shared club tournament).
    match /tournamentTeams/{teamId} {
      allow read: if isTrainer() || isStaffMember();
      allow create, update, delete: if isTrainer() || isStaffMember();
    }

    // Mail queue for the Firebase "Trigger Email from Firestore" extension.
    // Anyone may enqueue a notification; only the extension (which bypasses
    // rules) reads or deletes.
    match /mail/{emailId} {
      allow create: if true;
      allow read, delete: if false;
    }
  }
}
