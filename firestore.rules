rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Role hierarchy (see src/types/index.ts StaffRole for the full
    // explanation): superadmin > owner ("Club owner") > assistant, plus
    // 'pending' for a self-registered account awaiting a role grant.
    // Each deployment serves exactly one club (see CLAUDE.md's
    // multi-tenant model — new customer = new deployment), so none of
    // this needs to be scoped by clubId beyond what's already implicit.

    function isSignedIn() {
      return request.auth != null;
    }

    function hasStaffDoc() {
      return isSignedIn() && exists(/databases/$(database)/documents/staff/$(request.auth.uid));
    }

    function myRole() {
      return hasStaffDoc()
        ? get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.role
        : null;
    }

    function isSuperAdmin() {
      return myRole() == 'superadmin';
    }

    function isOwner() {
      return myRole() == 'owner';
    }

    // Can manage bookings/schedules — day-to-day operations.
    function isStaffMember() {
      return myRole() in ['superadmin', 'owner', 'assistant'];
    }

    // Can manage club config and grant/revoke the 'assistant' role.
    function isOwnerOrAbove() {
      return myRole() in ['superadmin', 'owner'];
    }

    // Club config — public read (needed to render the booking UI with no
    // login), writes restricted to the club's owner/superadmin.
    match /clubs/{clubId} {
      allow read: if true;
      allow write: if isOwnerOrAbove();
    }

    // A club's physical ice surfaces (e.g. "Main Hall", "Small Hall").
    // Public read (needed to render the booking calendar with no login).
    match /rinks/{rinkId} {
      allow read: if true;
      allow create, update: if isStaffMember();
      allow delete: if isOwnerOrAbove();
    }

    match /zones/{zoneId} {
      allow read: if true;
      allow create, update: if isStaffMember();
      allow delete: if isOwnerOrAbove();
    }

    match /timeSlotConfig/{configId} {
      allow read: if true;
      allow write: if isStaffMember();
    }

    // Recurring windows where the rink is offered as halves/thirds instead
    // of the default whole-rink booking (see src/lib/divisionRules.ts).
    match /divisionRules/{ruleId} {
      allow read: if true;
      allow create, update: if isStaffMember();
      allow delete: if isStaffMember();
    }

    match /staff/{uid} {
      // Anyone signed in may read their own doc (to see their own role).
      allow read: if isSignedIn() && request.auth.uid == uid;
      // Any active staff member can see the roster.
      allow read: if isStaffMember();

      // Self-registration: create your OWN doc, but only as 'pending' —
      // you cannot grant yourself a real role.
      allow create: if isSignedIn() && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.role == 'pending';

      // Role changes: superadmin can set any role on anyone; an owner can
      // only move a row between 'pending' and 'assistant' (never touching
      // owner/superadmin rows), and only the role field.
      allow update: if isSuperAdmin()
        || (isOwner()
            && resource.data.role in ['pending', 'assistant']
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role'])
            && request.resource.data.role in ['pending', 'assistant']);

      allow delete: if isSuperAdmin();
    }

    // Bookings: publicly creatable (anonymous booking, no login required)
    // and publicly readable so a customer can look themselves up by
    // confirmation code + email, or via their emailed cancel-link token.
    //
    // KNOWN LIMITATION (same trade-off the Arena-Srsnov reference app
    // makes on its `registrations` collection): public read also allows
    // listing/querying the whole collection directly, not just doc-by-id
    // lookups. Fine for a first build; before real traffic, move lookup
    // and cancellation through a Cloud Function so the client never
    // queries `bookings` directly.
    match /bookings/{bookingId} {
      allow read: if true;
      allow create: if true;
      // Public (customer self-cancel): only allow flipping status to
      // 'cancelled' (+ timestamp) — never arbitrary edits to name/zone/time.
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'cancelledAt'])
        && resource.data.status == 'confirmed'
        && request.resource.data.status == 'cancelled';
      // Staff (admin dashboard): full edit rights — cancel, create,
      // correct contact details, etc.
      allow update: if isStaffMember();
    }

    // A weekly-recurring series' metadata (see src/types/index.ts
    // BookingSeries) — the occurrences themselves are normal `bookings`
    // docs tagged with seriesId, covered by the rules above. Same
    // public-write trade-off as bookings/slotLocks: anyone can create one
    // (no-login booking), and it's publicly readable so the emailed
    // "manage series" link works without an account.
    match /bookingSeries/{seriesId} {
      allow read: if true;
      allow create: if true;
    }

    // Slot locks back the atomic check-and-reserve transaction in
    // src/lib/bookings.ts. Same public-write trade-off as bookings above.
    match /slotLocks/{lockId} {
      allow read: if true;
      allow create: if true;
      allow delete: if true;
    }

    // Mail queue for the Firebase "Trigger Email from Firestore" extension.
    // Anyone may enqueue a notification; only the extension (which bypasses
    // rules) reads or deletes.
    match /mail/{emailId} {
      allow create: if true;
      allow read, delete: if false;
    }
  }
}
