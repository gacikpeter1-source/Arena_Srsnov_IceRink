# Firebase project config (Project Settings → Your apps → Web app)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# The club served by this deployment (matches a document ID in the
# `clubs` collection). Enables one codebase to serve multiple tenants
# via separate Vercel projects/env vars.
VITE_CLUB_ID=arena-srsnov

# Stripe Connect — lets a club link its own Stripe account so ticket
# payments route directly to them (see lib/stripe.ts, functions/src/
# index.ts's stripeConnectCallback). Client ID is public (Settings →
# Connect → Settings in the Stripe dashboard, "ca_..."); the matching
# secret key is NOT an env var — set it via
# `firebase functions:secrets:set STRIPE_SECRET_KEY` instead.
VITE_STRIPE_PUBLISHABLE_KEY=
VITE_STRIPE_CONNECT_CLIENT_ID=
VITE_STRIPE_CONNECT_REDIRECT_URI=https://us-central1-arena-srsnov-reservation.cloudfunctions.net/stripeConnectCallback
