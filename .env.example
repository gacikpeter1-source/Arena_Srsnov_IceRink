# Firebase project config (Project Settings → Your apps → Web app)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# The club served by this deployment (matches a document ID in the
# `clubs` collection). Enables one codebase to serve multiple tenants
# via separate Vercel projects/env vars.
VITE_CLUB_ID=arena-srsnov
